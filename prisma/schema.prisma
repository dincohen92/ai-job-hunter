generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  hashedPassword String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  resumes         Resume[]
  savedJobs       SavedJob[]
  applications    Application[]
  emails          Email[]
  smtpConfig      SmtpConfig?
  cvProfile       CvProfile?
  coverLetters    CoverLetter[]
  contacts        Contact[]
  tasks           Task[]
  companies       Company[]
  recommendations JobRecommendation[]
  preferences     UserPreference?
  alerts          JobAlert[]
  notifications   Notification[]
  templates       ApplicationTemplate[]
  skillAnalyses   SkillAnalysis[]
  backups         Backup[]
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  fileName  String?
  rawText   String
  parsed    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tailoredVersions TailoredResume[]

  @@index([userId])
}

model TailoredResume {
  id             String   @id @default(cuid())
  resumeId       String
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId          String
  job            SavedJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tailoredText   String
  tailoredParsed String?
  matchScore     Int?
  suggestions    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([resumeId, jobId])
  @@index([resumeId])
  @@index([jobId])
}

model SavedJob {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId  String?
  source      String    @default("manual")
  title       String
  company     String
  location    String?
  description String
  requirements String?
  salary      String?
  jobType     String?
  applyUrl    String?
  companyLogo String?
  postedAt    DateTime?
  companyId   String?
  companyRef  Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  application      Application?
  tailoredResumes  TailoredResume[]
  generatedResumes GeneratedResume[]
  emails           Email[]
  coverLetters     CoverLetter[]
  tasks            Task[]
  recommendations  JobRecommendation[]
  // Salary tracking
  salaryMin        Int?
  salaryMax        Int?
  salaryExpectation Int?

  @@index([userId])
  @@index([companyId])
}

model Application {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String    @unique
  job       SavedJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String    @default("saved")
  notes     String?
  appliedAt DateTime?
  nextStep  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  interviews Interview[]
  tasks      Task[]
  offer      Offer?
  answers    ApplicationAnswer[]

  @@index([userId])
  @@index([userId, status])
}

model Email {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String?
  job            SavedJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  recipientEmail String
  recipientName  String?
  subject        String
  body           String
  status         String    @default("draft")
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([jobId])
}

model SmtpConfig {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  host     String
  port     Int     @default(587)
  secure   Boolean @default(false)
  username String
  password String
  fromName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CvProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName  String?
  email     String?
  phone     String?
  location  String?
  linkedin  String?
  website   String?
  summary   String?

  experience     String?
  education      String?
  skills         String?
  projects       String?
  certifications String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedResumes GeneratedResume[]
}

model GeneratedResume {
  id          String    @id @default(cuid())
  cvProfileId String
  cvProfile   CvProfile @relation(fields: [cvProfileId], references: [id], onDelete: Cascade)
  jobId       String
  job         SavedJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  content     String
  contentHtml String?
  matchScore  Int?
  changes     String?
  suggestions String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([cvProfileId])
  @@index([jobId])
}

model CoverLetter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       SavedJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  content   String
  tone      String   @default("professional")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([jobId])
}

model Contact {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  company          String?
  companyId        String?
  companyRef       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  role             String?
  email            String?
  phone            String?
  linkedInUrl      String?
  relationshipType String   @default("other") // recruiter, hiring_manager, referral, peer, other
  notes            String?
  tags             String?  // JSON array
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  interactions ContactInteraction[]
  tasks        Task[]

  @@index([userId])
  @@index([companyId])
}

model ContactInteraction {
  id         String   @id @default(cuid())
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type       String   // email, call, meeting, linkedin_message, coffee_chat
  date       DateTime
  notes      String?
  nextAction String?
  createdAt  DateTime @default(now())

  @@index([contactId])
}

model Interview {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  duration      Int?        // minutes
  type          String      @default("video") // phone, video, onsite, technical, behavioral, panel
  location      String?     // address or meeting link
  interviewers  String?     // JSON array of {name, role}
  status        String      @default("scheduled") // scheduled, completed, cancelled, rescheduled
  prepNotes     String?
  postNotes     String?
  // Reflection fields
  wentWell      String?
  toImprove     String?
  questionsAsked String?    // JSON array of questions they asked
  myQuestions   String?     // JSON array of questions I asked
  overallRating Int?        // 1-5 rating
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  questions     InterviewQuestion[]

  @@index([applicationId])
  @@index([scheduledAt])
}

model InterviewQuestion {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question    String
  type        String    // behavioral, technical, situational, company
  answer      String?   // User's prepared answer
  starAnswer  String?   // JSON {situation, task, action, result}
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([interviewId])
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  dueDate       DateTime?
  priority      String       @default("medium") // low, medium, high
  status        String       @default("pending") // pending, completed, cancelled
  type          String?      // follow_up, thank_you, check_in, apply, custom
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  jobId         String?
  job           SavedJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([dueDate])
  @@index([status])
}

model Company {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  website     String?
  industry    String?
  size        String?  // startup, small, medium, large, enterprise
  location    String?
  description String?
  culture     String?  // Notes about company culture
  techStack   String?  // JSON array of technologies
  glassdoor   String?  // Glassdoor URL or rating info
  linkedin    String?  // Company LinkedIn URL
  notes       String?  // General research notes
  pros        String?  // Positive aspects
  cons        String?  // Negative aspects / red flags
  salaryRange String?  // Typical salary range for roles
  interviewProcess String? // Notes about their interview process
  isTarget    Boolean  @default(false) // Marked as a target company to watch
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  savedJobs   SavedJob[]
  contacts    Contact[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isTarget])
}

model Offer {
  id              String      @id @default(cuid())
  applicationId   String      @unique
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  baseSalary      Int?
  bonus           Int?
  bonusType       String?     // signing, annual, performance
  equity          String?     // description of equity package
  equityValue     Int?        // estimated annual value
  vestingYears    Int?        @default(4)
  benefits        String?     // JSON or text description
  benefitsValue   Int?        // estimated annual value
  pto             Int?        // days per year
  remotePolicy    String?     // full, hybrid, onsite
  location        String?
  startDate       DateTime?
  expirationDate  DateTime?
  status          String      @default("pending") // pending, accepted, declined, expired, negotiating
  notes           String?
  negotiationLog  String?     // JSON array of negotiation rounds
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
}

// Issue #12: AI Job Recommendations
model JobRecommendation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       SavedJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score     Float    // 0-1 relevance score
  reason    String   // explanation
  feedback  String?  // liked, disliked, null
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([score])
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredTitles String?  // JSON array
  preferredSkills String?  // JSON array
  avoidCompanies  String?  // JSON array
  minSalary       Int?
  maxSalary       Int?
  remoteOnly      Boolean  @default(false)
  locations       String?  // JSON array
  jobType         String?  // "full-time", "part-time", "contract", "any"
  workStyle       String?  // "remote", "hybrid", "onsite", "any"
  experienceLevel String?  // "entry", "mid", "senior", "principal", "any"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Issue #13: Job Alerts & Notifications
model JobAlert {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  query        String
  location     String?
  filters      String?   // JSON of filter options
  sources      String?   // JSON array of job sources to search
  frequency    String    @default("daily") // instant, daily, weekly
  enabled      Boolean   @default(true)
  lastChecked  DateTime?
  lastNotified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notifications Notification[]

  @@index([userId])
  @@index([enabled])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // job_alert, reminder, system
  title     String
  message   String
  link      String?   // URL to navigate to
  read      Boolean   @default(false)
  alertId   String?
  alert     JobAlert? @relation(fields: [alertId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, read])
}

// Issue #14: Application Templates & Quick Apply
model ApplicationTemplate {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String   // authorization, salary, availability, about_me, why_here, custom
  question   String
  answer     String
  tags       String?  // JSON array
  charCount  Int?
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  answers ApplicationAnswer[]

  @@index([userId])
  @@index([category])
}

model ApplicationAnswer {
  id            String               @id @default(cuid())
  applicationId String
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  templateId    String?
  template      ApplicationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  question      String
  answer        String
  createdAt     DateTime             @default(now())

  @@index([applicationId])
}

// Issue #15: Skills Gap Analysis
model SkillAnalysis {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       String
  demandCount Int      // how many jobs request it
  hasSkill    Boolean  // user has this skill
  priority    String   @default("medium") // high, medium, low
  resources   String?  // JSON array of learning resources
  notes       String?
  status      String   @default("gap") // gap, learning, acquired
  updatedAt   DateTime @updatedAt

  @@unique([userId, skill])
  @@index([userId])
  @@index([priority])
}

// Issue #16: Import/Export & Data Backup
model Backup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  size      Int      // bytes
  data      String   // JSON blob (or path to file for large backups)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
